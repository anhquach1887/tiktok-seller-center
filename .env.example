# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Required for production. Each browser has its own isolated TikTok connection.
DASHBOARD_PASSWORD=
# Must match the public website origin exactly in production.
APP_ORIGIN=http://127.0.0.1:3000
# Persistent directory; do not use an ephemeral filesystem.
DATA_DIR=./data
PORT=3000
# Required on Vercel: Neon Postgres connection string. Leave empty for local SQLite.
DATABASE_URL=
# Generate a separate random 32+ character value. Also add it to GitHub repository secrets.
CRON_SECRET=
